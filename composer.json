{
  "name": "carono/yii2-online-target",
  "description": "Queue-backed JSON HTTP log target for Yii2",
  "type": "yii2-extension",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "yiisoft/yii2": "^2.0.49",
    "yiisoft/yii2-queue": "^2.3"
  },
  "require-dev": {"yidas/yii2-composer-bower-skip": "^2.0"},
  "autoload": {"psr-4": {"carono\\onlineTarget\\": "src/"}},
  "config": {"allow-plugins": {"yiisoft/yii2-composer": true}},
  "scripts": {"test": "php tests/run.php"}
}
